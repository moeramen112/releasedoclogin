# Set these in the environment before `npm start`. Everything except ADMIN_EMAIL (first run only) is optional.

# --- Sign-in ---
ADMIN_EMAIL=you@yourcompany.com   # creates the first admin on the very first start; the invite link is printed in the log
PUBLIC_URL=https://releases.yourcompany.com   # used in invite links and Slack messages
SESSION_SECRET=                   # optional. If empty, one is generated and kept in the data folder
COOKIE_SECURE=1                   # set to 1 when the site is served over https
TRUST_PROXY=1                     # set to 1 when a proxy in front of the server adds x-forwarded-proto and x-forwarded-for
HOST=0.0.0.0                      # default 127.0.0.1 (this computer only). Use 0.0.0.0 on a server.
PORT=3000
STATE_DIR=/data                   # where users, releases and audit logs are kept. Back this folder up.

# --- Connections ---
GITHUB_TOKEN=                     # raises the GitHub rate limit and allows private repos
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=                   # https://id.atlassian.com/manage-profile/security/api-tokens
SLACK_WEBHOOK_URL=                # incoming webhook for the go/no-go summary

# Background refresh and Slack alerts (set per release in the planner)
SYNC_MINUTES=5                    # how often releases with auto-refresh pull from Jira
ALERT_SETTLE_MINUTES=2            # a changed call must hold this long before Slack is told (stops flapping)
